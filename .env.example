# ===== LLM =====
# OpenAI 兼容接口（DeepSeek / Qwen / 本地 vLLM 都走这一组）
LLM_PROVIDER=openai
LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 或者 Claude
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-your-key

# ===== 本地模型缓存（国内走 hf-mirror） =====
HF_HOME=D:/Dev/cache/huggingface
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# 可填本地目录（推荐）或 HuggingFace repo id
EMBED_MODEL=D:/Dev/models/bge-m3
RERANK_MODEL=D:/Dev/models/bge-reranker-v2-m3

# ===== 检索调参 =====
# 进入 reranker 的候选数。CPU 上重排是主要耗时，10 与 20 的 Recall@5 一致。
RETRIEVAL_RECALL_K=10
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=8

# ===== 会话与向量库 =====
REDIS_URL=redis://localhost:6379/0
CHROMA_DIR=data/chroma
LOG_DIR=logs

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hr
MYSQL_PASSWORD=hr
MYSQL_DATABASE=hr

# ===== MCP 权限 =====
HR_ALLOWED_IDS=1001,1002,1003

# ===== 登录 =====
# 账号密码存放在 MySQL users 表，初始演示账号由 scripts/seed_users.py 写入
# 务必替换下面的 Token 签名密钥
HR_AUTH_SECRET=dev-only-change-me
HR_AUTH_TOKEN_TTL_HOURS=12
